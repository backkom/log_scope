{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogScope",
  "version": "0.1.2",
  "identifier": "com.logscope.viewer",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogScope",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Readonly log viewer",
    "longDescription": "LogScope is a high-performance readonly log viewer for large files and streaming log sources."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNEY0N0QzM0RCRTNFRDEKUldUUlByNDkwMGRQL1A3VWNLNmFuendMRVNSbEFsblF1Zzl0THR2WmRxS0lzT1dwRVFqeUgrbVkK",
      "endpoints": [
        "https://github.com/backkom/log_scope/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
