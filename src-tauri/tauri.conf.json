{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogScope",
  "version": "0.1.0",
  "identifier": "com.logscope.viewer",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogScope",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Readonly log viewer",
    "longDescription": "LogScope is a high-performance readonly log viewer for large files and streaming log sources."
  }
}
